entrypoint = "app.py"
run = "python3 -m streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true --browser.gatherUsageStats false"

[deployment]
run = ["python3", "-m", "streamlit", "run", "app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true", "--browser.gatherUsageStats", "false"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8501
externalPort = 80
